# Twisted23 Apache Configuration
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Enable rewrite engine
RewriteEngine On
RewriteBase /

# 1. HTTP Link Header pointing to agent-readable Markdown documentation
<IfModule mod_headers.c>
  Header append Link '<https://twisted23.com/llms.txt>; rel="alternate"; type="text/markdown"'

  # Forum image hotlinking: permissive CORS & immutable caching
  <FilesMatch "\.(png|jpe?g|gif|webp|svg|ico)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, OPTIONS"
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
</IfModule>

# 2. Markdown Negotiation: If client requests text/markdown or ?format=md on homepage, serve llms.txt
RewriteCond %{HTTP:Accept} text/markdown [NC,OR]
RewriteCond %{QUERY_STRING} format=md [NC,OR]
RewriteCond %{HTTP_USER_AGENT} (ClaudeBot|GPTBot|ChatGPT|Anthropic|PerplexityBot|Perplexity|Cohere|DeepSeek|Google-Extended) [NC]
RewriteRule ^$ /llms.txt [L]

# 2b. Capture real visitor telemetry when sLogbog or gravity-wizards pages embed /assets/* images
RewriteCond %{HTTP_REFERER} ^https?://([a-z0-9\-]+\.)*(slogbog\.com|slogfrog\.com|gravitywizards\.com|gpada\.org)(/|$) [NC]
RewriteRule ^assets/([A-Za-z0-9_\-\.]+\.(?:gif|png|svg|webp))$ /visitors/telemetry.php?action=asset&file=$1 [L,QSA]

# 3. Forum Picture URLs (pxURLs) & Legacy phpBB HotLink Routing
# Ultra-short /p/ and /pix/ rewrites to /px/
RewriteRule ^p/(.+)$ /px/$1 [L,NC]
RewriteRule ^pix/(.+)$ /px/$1 [L,NC]

# Legacy /is23pbHL/ route: If an image is requested, rewrite to /px/
RewriteRule ^is23pbHL/(.+\.(png|jpe?g|gif|webp|svg|ico))$ /px/$1 [L,NC]
RewriteRule ^is23pbHL/?$ /px/ [R=301,L]

# Friendly aliases for UCP/GwCrm
Redirect 302 /forum /ucp/?mode=memberlist
Redirect 302 /forum/ /ucp/?mode=memberlist
Redirect 302 /gwcrm /crm/
Redirect 302 /GwCrm /crm/

# 4. Standard UTF-8 charset
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .json .svg .webmanifest

# 5. Ensure clean MIME types
AddType application/javascript js
AddType image/svg+xml svg
AddType text/plain txt
AddType application/xml xml
