Options -Indexes
RewriteEngine On

# Protect private data directory, config, and PHP libraries
RewriteRule ^data/ - [F,L]
RewriteRule ^lib/ - [F,L]
RewriteRule ^config\.php$ - [F,L]

# Route api/* cleanly to api.php (works at root or any subfolder)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/(.*)$ api.php?route=$1 [QSA,L]

# Route i/<filename> to cached image server
RewriteRule ^i/([0-9a-z_-]+\.(webp|jpg|png|gif))$ image.php?name=$1 [QSA,L]

# Aggressive caching for Cloudflare/CDN + browsers on Hostinger LiteSpeed/Apache
<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css|webp|jpg|png|gif|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set CDN-Cache-Control "public, max-age=31536000, immutable"
    Header set Cloudflare-CDN-Cache-Control "public, max-age=31536000, immutable"
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
  <FilesMatch "\.(php)$">
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>
